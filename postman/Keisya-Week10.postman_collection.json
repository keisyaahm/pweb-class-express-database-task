{
  "info": {
    "name": "Keisya Week 10 - Product API",
    "description": "Koleksi pengujian CRUD Product API (Express + Prisma + PostgreSQL). Ubah variable productId sesuai ID hasil POST.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "productId", "value": "1" }
  ],
  "item": [
    {
      "name": "01 - Success GET all products",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
      }
    },
    {
      "name": "02 - Success POST product 1",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Buku\",\n  \"price\": 15000\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
      }
    },
    {
      "name": "03 - Success POST product 2",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Pulpen\",\n  \"price\": 5000\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
      }
    },
    {
      "name": "04 - Success GET product by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
      }
    },
    {
      "name": "05 - Success PUT product",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Buku Tulis\",\n  \"price\": 17500\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
      }
    },
    {
      "name": "06 - Success DELETE product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
      }
    },
    {
      "name": "07 - Error GET id not found",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/999999", "host": ["{{baseUrl}}"], "path": ["products", "999999"] }
      }
    },
    {
      "name": "08 - Error invalid id",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/abc", "host": ["{{baseUrl}}"], "path": ["products", "abc"] }
      }
    },
    {
      "name": "09 - Error POST empty name",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"price\": 10000\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
      }
    },
    {
      "name": "10 - Error POST negative price",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Buku\",\n  \"price\": -5\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
      }
    },
    {
      "name": "11 - Error POST decimal price",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Buku\",\n  \"price\": 3.5\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
      }
    },
    {
      "name": "12 - Error DELETE id not found",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/999999", "host": ["{{baseUrl}}"], "path": ["products", "999999"] }
      }
    }
  ]
}
