generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   @default("Lainnya")
  price       Int
  stock       Int      @default(0)
  sku         String?  @unique
  description String   @default("")
  createdAt   DateTime @default(now())
}
